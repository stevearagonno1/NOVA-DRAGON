# ── NOVA v5 — ملف الأسرار (M0) ───────────────────────────────
# انسخ هذا الملف إلى `.env` ثم ضع قيمك فيه.
# ⚠️ أبداً لا ترفع ملف `.env` في أي مشاركة/محادثة.

# بيئة التداول: testnet (افتراضي) أو live — نعمل Testnet حصراً حتى الـ Backtest.
BINANCE_ENV=testnet

# مفاتيح Binance (تُجدَّد في لوحة المنصة لأنّ المدى السابق كُشف)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# تليجرام
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# سطّر التداول (مُقفل Testnet حتى تريد الإطلاق الحي)
AUTO_TRADE=1

# قيمة كل صفقة (القيمة الاسمية الأساسية قبل التدرّج)
TRADE_NOTIONAL_USD=10
MAX_POSITIONS=3

# قائمة العملات (~50 أعلى سيولة، تُحدَّث كل 10 دقائق)
TOP_N_SYMBOLS=50
UNIVERSE_REFRESH_SEC=600

SELECT_QUOTE=USDT
